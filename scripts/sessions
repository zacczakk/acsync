#!/usr/bin/env python3
"""sessions — search, export, and browse OpenCode, Claude Code, and Codex sessions.

Usage:
    sessions list   [--source opencode|opencode2|claude|codex] [--since DATE] [--limit N] [--project NAME]
    sessions export [--source opencode|opencode2|claude|codex] [--since DATE] [--force]
    sessions search <query> [--source opencode|opencode2|claude|codex] [--since DATE] [--limit N] [--role user|assistant] [--context N]
    sessions read   <session_id> [--role user|assistant] [--no-tools]
    sessions find   <query> [--limit N]
    sessions stats
"""

from __future__ import annotations

import argparse
import json
import re
import sqlite3
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

from sessions_codex import list_sessions as codex_list_sessions
from sessions_codex import read_metadata as codex_read_metadata
from sessions_codex import read_session as codex_read_session
from sessions_codex import session_to_markdown as codex_session_to_markdown
from sessions_opencode import DEFAULT_DB as DEFAULT_OPENCODE2_DB
from sessions_opencode import list_sessions as opencode2_list_sessions
from sessions_opencode import open_db as opencode2_db
from sessions_opencode import read_session as opencode2_read_session
from sessions_opencode import session_to_markdown as opencode2_session_to_markdown
from sessions_opencode import stats as opencode2_stats
from sessions_opencode import text_blocks_since as opencode2_text_blocks_since

# --- Paths -------------------------------------------------------------------

OPENCODE_DB = Path.home() / ".local" / "share" / "opencode" / "opencode.db"
OPENCODE2_DB = DEFAULT_OPENCODE2_DB
CLAUDE_DIR = Path.home() / ".claude" / "projects"
CODEX_DIR = Path.home() / ".codex" / "sessions"
VAULT_DIR = Path.home() / "Vaults" / "Sessions"
OPENCODE_VAULT = VAULT_DIR / "opencode"
OPENCODE2_VAULT = VAULT_DIR / "opencode2"
CLAUDE_VAULT = VAULT_DIR / "claude"
CODEX_VAULT = VAULT_DIR / "codex"
LOCAL_DATA = Path.home() / ".local" / "share" / "sessions"
FTS_DB = LOCAL_DATA / ".sessions-fts.db"
EXPORT_STATE = LOCAL_DATA / ".export-state.json"


# --- Helpers ------------------------------------------------------------------

def ts_to_dt(ts_ms: int) -> datetime:
    return datetime.fromtimestamp(ts_ms / 1000, tz=timezone.utc)


def dt_to_str(dt: datetime) -> str:
    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")


def slugify(text: str, max_len: int = 60) -> str:
    s = re.sub(r"[^\w\s-]", "", text.lower())
    s = re.sub(r"[\s_]+", "-", s).strip("-")
    return s[:max_len].rstrip("-")


def parse_date(s: str | None) -> datetime | None:
    if not s:
        return None
    for fmt in ("%Y-%m-%d", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M:%SZ"):
        try:
            return datetime.strptime(s, fmt).replace(tzinfo=timezone.utc)
        except ValueError:
            continue
    print(f"error: cannot parse date '{s}'", file=sys.stderr)
    sys.exit(1)


def load_export_state() -> dict:
    if EXPORT_STATE.exists():
        return json.loads(EXPORT_STATE.read_text())
    return {
        "opencode_last_ts": 0,
        "opencode2_exported": {},
        "claude_exported": [],
        "codex_exported": [],
    }


def save_export_state(state: dict):
    EXPORT_STATE.parent.mkdir(parents=True, exist_ok=True)
    EXPORT_STATE.write_text(json.dumps(state, indent=2) + "\n")


def project_name_from_dir(directory: str) -> str:
    return Path(directory).name


# --- OpenCode DB access -------------------------------------------------------

def opencode_db() -> sqlite3.Connection:
    if not OPENCODE_DB.exists():
        print(f"error: OpenCode DB not found at {OPENCODE_DB}", file=sys.stderr)
        sys.exit(1)
    conn = sqlite3.connect(f"file:{OPENCODE_DB}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    return conn


def opencode_list_sessions(since: datetime | None = None, limit: int = 20,
                           project: str | None = None) -> list[dict]:
    conn = opencode_db()
    q = "SELECT s.id, s.title, s.directory, s.time_created, s.time_updated, s.parent_id FROM session s"
    conds, params = [], []
    if since:
        conds.append("s.time_created >= ?")
        params.append(int(since.timestamp() * 1000))
    if project:
        conds.append("s.directory LIKE ?")
        params.append(f"%/{project}%")
    if conds:
        q += " WHERE " + " AND ".join(conds)
    q += " ORDER BY s.time_created DESC LIMIT ?"
    params.append(limit)
    rows = conn.execute(q, params).fetchall()
    conn.close()
    return [dict(r) for r in rows]


def opencode_read_session(session_id: str, role_filter: str | None = None,
                          include_tools: bool = True) -> list[dict]:
    """Return messages for a session, ordered chronologically."""
    conn = opencode_db()
    q = """
        SELECT m.id as msg_id, json_extract(m.data, '$.role') as role,
               m.time_created,
               p.id as part_id, json_extract(p.data, '$.type') as ptype,
               p.data as pdata
        FROM message m
        JOIN part p ON p.message_id = m.id
        WHERE m.session_id = ?
        ORDER BY m.time_created, p.time_created
    """
    rows = conn.execute(q, (session_id,)).fetchall()
    conn.close()

    messages = []
    for r in rows:
        ptype = r["ptype"]
        role = r["role"]

        if role_filter and role != role_filter:
            continue

        if ptype == "text":
            data = json.loads(r["pdata"])
            text = data.get("text", "").strip()
            if text:
                messages.append({"role": role, "type": "text", "text": text,
                                 "ts": r["time_created"]})
        elif ptype == "tool" and include_tools:
            data = json.loads(r["pdata"])
            tool_name = data.get("tool", "unknown")
            state = data.get("state", {})
            inp = state.get("input", {})
            inp_summary = json.dumps(inp)[:200] if isinstance(inp, dict) else str(inp)[:200]
            messages.append({"role": role, "type": "tool", "tool": tool_name,
                             "input_summary": inp_summary, "ts": r["time_created"]})
    return messages


def opencode_session_to_markdown(session_id: str) -> str | None:
    """Export a single OpenCode session as markdown."""
    conn = opencode_db()
    row = conn.execute(
        "SELECT id, title, directory, time_created, time_updated, parent_id FROM session WHERE id = ?",
        (session_id,)
    ).fetchone()
    if not row:
        conn.close()
        return None

    title = row["title"]
    directory = row["directory"]
    created = ts_to_dt(row["time_created"])
    parent_id = row["parent_id"]
    project = project_name_from_dir(directory)

    # Get model from first assistant message
    model_row = conn.execute(
        "SELECT json_extract(data, '$.modelID') as model FROM message WHERE session_id = ? AND json_extract(data, '$.role') = 'assistant' LIMIT 1",
        (session_id,)
    ).fetchone()
    model = model_row["model"] if model_row else "unknown"
    conn.close()

    messages = opencode_read_session(session_id, include_tools=False)
    if not messages:
        return None

    lines = [
        "---",
        f"session_id: {session_id}",
        "source: opencode",
        f'title: "{title}"',
        f"project: {project}",
        f"directory: {directory}",
        f"created: {dt_to_str(created)}",
        f"model: {model}",
    ]
    if parent_id:
        lines.append(f"parent_session: {parent_id}")
    lines.append("---")
    lines.append("")

    current_role = None
    for msg in messages:
        if msg["role"] != current_role:
            current_role = msg["role"]
            label = "User" if current_role == "user" else "Assistant"
            lines.append(f"## {label}")
            lines.append("")
        lines.append(msg["text"])
        lines.append("")

    return "\n".join(lines)


# --- Claude Code access -------------------------------------------------------

def claude_list_sessions(since: datetime | None = None, limit: int = 20,
                         project: str | None = None) -> list[dict]:
    if not CLAUDE_DIR.exists():
        return []

    sessions = []
    for jsonl in CLAUDE_DIR.rglob("*.jsonl"):
        if "subagents" in str(jsonl):
            # still index subagent sessions — extract parent from path
            pass

        try:
            first_line = None
            with open(jsonl) as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        d = json.loads(line)
                        if d.get("type") in ("user", "assistant", "progress"):
                            first_line = d
                            break
                    except json.JSONDecodeError:
                        continue
            if not first_line:
                continue

            ts_str = first_line.get("timestamp", "")
            try:
                ts = datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
            except (ValueError, AttributeError):
                continue

            if since and ts < since:
                continue

            cwd = first_line.get("cwd", "")
            proj = project_name_from_dir(cwd) if cwd else "unknown"

            if project and project.lower() not in proj.lower():
                continue

            sid = first_line.get("sessionId", jsonl.stem)
            is_subagent = "subagents" in str(jsonl)

            sessions.append({
                "id": sid,
                "title": f"{'[sub] ' if is_subagent else ''}{proj} session",
                "directory": cwd,
                "time_created": int(ts.timestamp() * 1000),
                "time_updated": int(ts.timestamp() * 1000),
                "parent_id": None,
                "source_file": str(jsonl),
                "is_subagent": is_subagent,
            })
        except Exception:
            continue

    sessions.sort(key=lambda s: s["time_created"], reverse=True)
    return sessions[:limit]


def claude_read_session(jsonl_path: str, role_filter: str | None = None) -> list[dict]:
    messages = []
    with open(jsonl_path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except json.JSONDecodeError:
                continue

            msg_type = d.get("type")
            if msg_type == "user":
                if role_filter and role_filter != "user":
                    continue
                content = d.get("message", {}).get("content", "")
                if isinstance(content, str) and content.strip():
                    messages.append({
                        "role": "user", "type": "text", "text": content.strip(),
                        "ts": d.get("timestamp", "")
                    })
            elif msg_type == "assistant":
                if role_filter and role_filter != "assistant":
                    continue
                content = d.get("message", {}).get("content", [])
                if isinstance(content, list):
                    for block in content:
                        if block.get("type") == "text":
                            text = block.get("text", "").strip()
                            if text:
                                messages.append({
                                    "role": "assistant", "type": "text", "text": text,
                                    "ts": d.get("timestamp", "")
                                })
    return messages


def claude_session_to_markdown(jsonl_path: str) -> str | None:
    """Export a single Claude Code session as markdown."""
    meta = None
    with open(jsonl_path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
                if d.get("type") in ("user", "assistant", "progress"):
                    meta = d
                    break
            except json.JSONDecodeError:
                continue

    if not meta:
        return None

    sid = meta.get("sessionId", Path(jsonl_path).stem)
    cwd = meta.get("cwd", "")
    project = project_name_from_dir(cwd) if cwd else "unknown"
    ts_str = meta.get("timestamp", "")
    model = ""
    is_subagent = "subagents" in jsonl_path

    # find model from first assistant message
    with open(jsonl_path) as f:
        for line in f:
            try:
                d = json.loads(line)
                if d.get("type") == "assistant":
                    model = d.get("message", {}).get("model", "unknown")
                    break
            except json.JSONDecodeError:
                continue

    messages = claude_read_session(jsonl_path)
    if not messages:
        return None

    # build title from first user message
    title = "Claude Code session"
    for m in messages:
        if m["role"] == "user":
            title = m["text"][:80]
            break

    lines = [
        "---",
        f"session_id: {sid}",
        "source: claude",
        f'title: "{title}"',
        f"project: {project}",
        f"directory: {cwd}",
        f"created: {ts_str}",
        f"model: {model}",
        f"is_subagent: {is_subagent}",
        f"source_file: {jsonl_path}",
        "---",
        "",
    ]

    current_role = None
    for msg in messages:
        if msg["role"] != current_role:
            current_role = msg["role"]
            label = "User" if current_role == "user" else "Assistant"
            lines.append(f"## {label}")
            lines.append("")
        lines.append(msg["text"])
        lines.append("")

    return "\n".join(lines)


# --- FTS5 Index ---------------------------------------------------------------

def fts_db() -> sqlite3.Connection:
    FTS_DB.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(FTS_DB))
    conn.execute("""
        CREATE VIRTUAL TABLE IF NOT EXISTS session_fts USING fts5(
            session_id, source, role, text,
            tokenize='porter unicode61'
        )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS fts_meta (
            key TEXT PRIMARY KEY,
            value TEXT
        )
    """)
    conn.commit()
    return conn


def fts_index_opencode():
    """Index OpenCode text parts into FTS5. Self-tracking via fts_meta."""
    if not OPENCODE_DB.exists():
        return 0
    src = opencode_db()
    dst = fts_db()

    row = dst.execute("SELECT value FROM fts_meta WHERE key = 'opencode_last_ts'").fetchone()
    since_ts = int(row[0]) if row else 0

    q = """
        SELECT m.session_id, json_extract(m.data, '$.role') as role,
               json_extract(p.data, '$.text') as text,
               p.time_created
        FROM message m
        JOIN part p ON p.message_id = m.id
        WHERE json_extract(p.data, '$.type') = 'text'
        AND p.time_created > ?
        ORDER BY p.time_created
    """
    rows = src.execute(q, (since_ts,)).fetchall()
    src.close()

    batch = []
    for r in rows:
        text = r[2]
        if not text or not text.strip():
            continue
        batch.append((r[0], "opencode", r[1], text.strip()))

    if batch:
        dst.executemany(
            "INSERT INTO session_fts (session_id, source, role, text) VALUES (?, ?, ?, ?)",
            batch
        )
        dst.execute(
            "INSERT OR REPLACE INTO fts_meta (key, value) VALUES ('opencode_last_ts', ?)",
            (str(rows[-1][3]),)
        )
        dst.commit()

    dst.close()
    return len(batch)


def fts_index_opencode2():
    """Index OpenCode V2 visible text into FTS5."""
    src = OPENCODE2_DB
    if not src.exists():
        return 0

    dst = fts_db()
    # V2 records can be edited and share timestamps, so rebuild this source slice.
    blocks = opencode2_text_blocks_since(src, -1)
    dst.execute("DELETE FROM session_fts WHERE source = 'opencode2'")

    if blocks:
        dst.executemany(
            "INSERT INTO session_fts (session_id, source, role, text) VALUES (?, ?, ?, ?)",
            [(session_id, "opencode2", role, text) for session_id, role, text, _ in blocks],
        )
    dst.commit()

    dst.close()
    return len(blocks)


def fts_index_claude():
    """Index Claude Code sessions into FTS5."""
    dst = fts_db()

    # get already-indexed files
    row = dst.execute(
        "SELECT value FROM fts_meta WHERE key = 'claude_indexed_files'"
    ).fetchone()
    indexed = set(json.loads(row[0])) if row else set()

    if not CLAUDE_DIR.exists():
        dst.close()
        return 0

    count = 0
    new_indexed = set(indexed)
    for jsonl in CLAUDE_DIR.rglob("*.jsonl"):
        path_str = str(jsonl)
        if path_str in indexed:
            continue

        messages = claude_read_session(path_str)
        # extract session id from first event
        sid = jsonl.stem
        try:
            with open(jsonl) as f:
                for line in f:
                    d = json.loads(line.strip())
                    if "sessionId" in d:
                        sid = d["sessionId"]
                        break
        except Exception:
            pass

        batch = []
        for m in messages:
            if m["text"].strip():
                batch.append((sid, "claude", m["role"], m["text"].strip()))

        if batch:
            dst.executemany(
                "INSERT INTO session_fts (session_id, source, role, text) VALUES (?, ?, ?, ?)",
                batch
            )
            count += len(batch)

        new_indexed.add(path_str)

    dst.execute(
        "INSERT OR REPLACE INTO fts_meta (key, value) VALUES ('claude_indexed_files', ?)",
        (json.dumps(list(new_indexed)),)
    )
    dst.commit()
    dst.close()
    return count


def fts_index_codex():
    """Index Codex rollout sessions into FTS5."""
    dst = fts_db()
    row = dst.execute(
        "SELECT value FROM fts_meta WHERE key = 'codex_indexed_files'"
    ).fetchone()
    stored = json.loads(row[0]) if row else {}
    indexed = stored if isinstance(stored, dict) else {}
    if not CODEX_DIR.exists():
        dst.close()
        return 0

    count = 0
    new_indexed = dict(indexed)
    for jsonl in CODEX_DIR.rglob("*.jsonl"):
        path_str = str(jsonl)
        modified = jsonl.stat().st_mtime_ns
        if indexed.get(path_str) == modified:
            continue
        meta = codex_read_metadata(jsonl) or {}
        session_id = meta.get("id") or meta.get("session_id") or jsonl.stem
        batch = [
            (session_id, "codex", message["role"], message["text"].strip())
            for message in codex_read_session(jsonl, include_tools=False)
            if message["text"].strip()
        ]
        dst.execute(
            "DELETE FROM session_fts WHERE source = 'codex' AND session_id = ?",
            (session_id,),
        )
        if batch:
            dst.executemany(
                "INSERT INTO session_fts (session_id, source, role, text) VALUES (?, ?, ?, ?)",
                batch,
            )
            count += len(batch)
        new_indexed[path_str] = modified

    dst.execute(
        "INSERT OR REPLACE INTO fts_meta (key, value) VALUES ('codex_indexed_files', ?)",
        (json.dumps(new_indexed),),
    )
    dst.commit()
    dst.close()
    return count


def fts_search(query: str, source: str | None = None, role: str | None = None,
               limit: int = 10, context: int = 0) -> list[dict]:
    conn = fts_db()

    # Build FTS match expression
    fts_query = query
    if source:
        fts_query = f'source:"{source}" AND ({query})'
    if role:
        fts_query = f'role:"{role}" AND ({fts_query})'

    try:
        rows = conn.execute(
            """SELECT session_id, source, role, snippet(session_fts, 3, '>>>', '<<<', '...', 64) as snippet,
                      rank
               FROM session_fts
               WHERE session_fts MATCH ?
               ORDER BY rank
               LIMIT ?""",
            (fts_query, limit)
        ).fetchall()
    except sqlite3.OperationalError:
        # fallback: simpler query without column filters
        rows = conn.execute(
            """SELECT session_id, source, role, snippet(session_fts, 3, '>>>', '<<<', '...', 64) as snippet,
                      rank
               FROM session_fts
               WHERE session_fts MATCH ?
               ORDER BY rank
               LIMIT ?""",
            (query, limit)
        ).fetchall()

    conn.close()
    return [{"session_id": r[0], "source": r[1], "role": r[2],
             "snippet": r[3], "rank": r[4]} for r in rows]


# --- Commands -----------------------------------------------------------------

def cmd_list(args):
    json_rows = []
    results = []

    if args.source == "opencode" or (args.source is None and OPENCODE_DB.exists()):
        since = parse_date(args.since)
        sessions = opencode_list_sessions(since=since, limit=args.limit, project=args.project)
        for s in sessions:
            dt = ts_to_dt(s["time_created"])
            proj = project_name_from_dir(s["directory"])
            is_sub = bool(s["parent_id"])
            if args.json:
                json_rows.append({
                    "id": s["id"],
                    "title": s["title"],
                    "date": dt_to_str(dt),
                    "source": "opencode",
                    "project": proj,
                    "directory": s["directory"],
                    "is_subagent": is_sub,
                    "parent_id": s["parent_id"],
                    "time_created": s["time_created"],
                    "time_updated": s["time_updated"],
                })
            else:
                sub_label = " [sub]" if is_sub else ""
                results.append((dt, f"[opencode{sub_label}] {dt.strftime('%Y-%m-%d %H:%M')}  {proj:20s}  {s['title'][:60]}  ({s['id']})"))

    if args.source in (None, "opencode2") and OPENCODE2_DB.exists():
        since = parse_date(args.since)
        sessions = opencode2_list_sessions(OPENCODE2_DB, since=since, limit=args.limit, project=args.project)
        for s in sessions:
            dt = ts_to_dt(s["time_created"])
            proj = project_name_from_dir(s["directory"])
            is_sub = bool(s["parent_id"])
            title = s["title"] or "OpenCode V2 session"
            if args.json:
                json_rows.append({
                    "id": s["id"],
                    "title": title,
                    "date": dt_to_str(dt),
                    "source": "opencode2",
                    "project": proj,
                    "directory": s["directory"],
                    "is_subagent": is_sub,
                    "parent_id": s["parent_id"],
                    "time_created": s["time_created"],
                    "time_updated": s["time_updated"],
                })
            else:
                sub_label = " [sub]" if is_sub else ""
                results.append((dt, f"[opencode2{sub_label}] {dt.strftime('%Y-%m-%d %H:%M')}  {proj:20s}  {title[:60]}  ({s['id']})"))

    if args.source in (None, "claude"):
        since = parse_date(args.since)
        sessions = claude_list_sessions(since=since, limit=args.limit, project=args.project)
        for s in sessions:
            dt = ts_to_dt(s["time_created"])
            proj = project_name_from_dir(s["directory"])
            is_sub = bool(s.get("is_subagent"))
            if args.json:
                json_rows.append({
                    "id": s["id"],
                    "title": s["title"],
                    "date": dt_to_str(dt),
                    "source": "claude",
                    "project": proj,
                    "directory": s["directory"],
                    "is_subagent": is_sub,
                    "parent_id": s.get("parent_id"),
                    "time_created": s["time_created"],
                    "time_updated": s["time_updated"],
                    "source_file": s.get("source_file"),
                })
            else:
                sub_label = " [sub]" if is_sub else ""
                results.append((dt, f"[claude{sub_label}]   {dt.strftime('%Y-%m-%d %H:%M')}  {proj:20s}  {s['title'][:60]}"))

    if args.source in (None, "codex"):
        since = parse_date(args.since)
        sessions = codex_list_sessions(CODEX_DIR, since=since, limit=args.limit, project=args.project)
        for s in sessions:
            dt = ts_to_dt(s["time_created"])
            proj = project_name_from_dir(s["directory"])
            is_sub = bool(s.get("is_subagent"))
            if args.json:
                json_rows.append({
                    "id": s["id"], "title": s["title"], "date": dt_to_str(dt),
                    "source": "codex", "project": proj, "directory": s["directory"],
                    "is_subagent": is_sub, "parent_id": s.get("parent_id"),
                    "time_created": s["time_created"], "time_updated": s["time_updated"],
                    "source_file": s.get("source_file"),
                })
            else:
                sub_label = " [sub]" if is_sub else ""
                results.append((dt, f"[codex{sub_label}]    {dt.strftime('%Y-%m-%d %H:%M')}  {proj:20s}  {s['title'][:60]}"))

    if args.json:
        json_rows.sort(key=lambda r: r["time_created"], reverse=True)
        print(json.dumps(json_rows[:args.limit], indent=2))
        return

    results.sort(key=lambda x: x[0], reverse=True)
    for _, line in results[:args.limit]:
        print(line)

    if not results:
        print("no sessions found")


def cmd_export(args):
    dry_run = args.dry_run
    state = load_export_state()
    force = args.force
    total = 0

    if not dry_run:
        # Ensure vault dirs exist
        OPENCODE_VAULT.mkdir(parents=True, exist_ok=True)
        OPENCODE2_VAULT.mkdir(parents=True, exist_ok=True)
        CLAUDE_VAULT.mkdir(parents=True, exist_ok=True)
        CODEX_VAULT.mkdir(parents=True, exist_ok=True)

    if args.source == "opencode" or (args.source is None and OPENCODE_DB.exists()):
        since_ts = 0 if force else state.get("opencode_last_ts", 0)
        since = parse_date(args.since)
        if since:
            since_ts = max(since_ts, int(since.timestamp() * 1000))

        conn = opencode_db()
        q = "SELECT id, title, time_created FROM session WHERE time_created > ? ORDER BY time_created"
        rows = conn.execute(q, (since_ts,)).fetchall()
        conn.close()

        max_ts = since_ts
        for r in rows:
            md = opencode_session_to_markdown(r["id"])
            if not md:
                continue
            dt = ts_to_dt(r["time_created"])
            slug = slugify(r["title"])
            filename = f"{dt.strftime('%Y-%m-%d')}-{slug}.md"
            if dry_run:
                print(f"would write: {OPENCODE_VAULT / filename}")
            else:
                (OPENCODE_VAULT / filename).write_text(md)
                max_ts = max(max_ts, r["time_created"])
            total += 1

        if not dry_run:
            state["opencode_last_ts"] = max_ts
            print(f"exported {total} opencode sessions")

    if args.source in (None, "opencode2") and OPENCODE2_DB.exists():
        exported_state = state.get("opencode2_exported", {})
        exported = exported_state if isinstance(exported_state, dict) else {}
        if force:
            exported = {}
        since = parse_date(args.since)
        conn = opencode2_db(OPENCODE2_DB)
        query = "SELECT id, title, time_created, time_updated FROM session_v2"
        params: tuple[object, ...] = ()
        if since:
            query += " WHERE time_created >= ?"
            params = (int(since.timestamp() * 1000),)
        query += " ORDER BY time_created"
        rows = conn.execute(query, params).fetchall()
        conn.close()

        opencode2_count = 0
        for row in rows:
            if not force and exported.get(row["id"]) == row["time_updated"]:
                continue
            markdown = opencode2_session_to_markdown(OPENCODE2_DB, row["id"])
            if not markdown:
                continue
            dt = ts_to_dt(row["time_created"])
            title = row["title"] or "opencode2-session"
            filename = f"{dt.strftime('%Y-%m-%d')}-{slugify(title)}.md"
            if dry_run:
                print(f"would write: {OPENCODE2_VAULT / filename}")
            else:
                (OPENCODE2_VAULT / filename).write_text(markdown)
                exported[row["id"]] = row["time_updated"]
            total += 1
            opencode2_count += 1

        if not dry_run:
            state["opencode2_exported"] = exported
            print(f"exported {opencode2_count} opencode2 sessions")

    claude_count = 0
    if args.source in (None, "claude"):
        exported = set(state.get("claude_exported", []))
        since = parse_date(args.since)

        if force:
            exported = set()

        if CLAUDE_DIR.exists():
            for jsonl in CLAUDE_DIR.rglob("*.jsonl"):
                path_str = str(jsonl)
                if path_str in exported:
                    continue

                md = claude_session_to_markdown(path_str)
                if not md:
                    if not dry_run:
                        exported.add(path_str)
                    continue

                # extract date from first event
                try:
                    with open(jsonl) as f:
                        for line in f:
                            d = json.loads(line.strip())
                            if "timestamp" in d:
                                ts_str = d["timestamp"]
                                ts = datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
                                if since and ts < since:
                                    break
                                date_prefix = ts.strftime("%Y-%m-%d")
                                break
                        else:
                            date_prefix = "unknown"
                except Exception:
                    date_prefix = "unknown"

                sid = jsonl.stem
                is_sub = "subagents" in path_str
                prefix = "sub-" if is_sub else ""
                filename = f"{date_prefix}-{prefix}{slugify(sid[:30])}.md"
                if dry_run:
                    print(f"would write: {CLAUDE_VAULT / filename}")
                else:
                    (CLAUDE_VAULT / filename).write_text(md)
                    exported.add(path_str)
                claude_count += 1

        if not dry_run:
            state["claude_exported"] = list(exported)
            print(f"exported {claude_count} claude sessions")

    codex_count = 0
    if args.source in (None, "codex"):
        stored = state.get("codex_exported", {})
        exported = stored if isinstance(stored, dict) else {}
        since = parse_date(args.since)
        if force:
            exported = {}
        for session in codex_list_sessions(CODEX_DIR, since=since, limit=sys.maxsize):
            path_str = session["source_file"]
            modified = Path(path_str).stat().st_mtime_ns
            if exported.get(path_str) == modified:
                continue
            md = codex_session_to_markdown(path_str)
            if not md:
                if not dry_run:
                    exported[path_str] = modified
                continue
            dt = ts_to_dt(session["time_created"])
            filename = f"{dt.strftime('%Y-%m-%d')}-{slugify(session['id'][:30])}.md"
            if dry_run:
                print(f"would write: {CODEX_VAULT / filename}")
            else:
                (CODEX_VAULT / filename).write_text(md)
                exported[path_str] = modified
            codex_count += 1
        if not dry_run:
            state["codex_exported"] = exported
            print(f"exported {codex_count} codex sessions")

    if dry_run:
        return

    save_export_state(state)

    # rebuild FTS index
    print("rebuilding FTS index...")
    fts_conn = fts_db()
    if force:
        fts_conn.execute("DELETE FROM session_fts")
        fts_conn.execute("DELETE FROM fts_meta")
        fts_conn.commit()
    fts_conn.close()

    # FTS tracks its own watermark via fts_meta table
    oc_count = fts_index_opencode()
    oc2_count = fts_index_opencode2()
    cl_count = fts_index_claude()
    cx_count = fts_index_codex()
    print(f"indexed {oc_count} opencode + {oc2_count} opencode2 + {cl_count} claude + {cx_count} codex text blocks")

    # qmd collection index
    if not args.no_index:
        qmd_index(embed=True)


def cmd_search(args):
    results = fts_search(
        query=args.query,
        source=args.source,
        role=args.role,
        limit=args.limit,
        context=args.context,
    )
    if not results:
        if args.json:
            print("[]")
        else:
            print("no matches")
        return

    if args.json:
        # enrich with title/date from opencode db where possible
        conn = opencode_db() if OPENCODE_DB.exists() else None
        conn2 = opencode2_db(OPENCODE2_DB) if OPENCODE2_DB.exists() else None
        out = []
        for r in results:
            title = None
            date = None
            if conn and r["source"] == "opencode":
                row = conn.execute(
                    "SELECT title, time_created FROM session WHERE id = ?",
                    (r["session_id"],)
                ).fetchone()
                if row:
                    title = row["title"]
                    date = dt_to_str(ts_to_dt(row["time_created"]))
            elif conn2 and r["source"] == "opencode2":
                row = conn2.execute(
                    "SELECT title, time_created FROM session_v2 WHERE id = ?",
                    (r["session_id"],),
                ).fetchone()
                if row:
                    title = row["title"]
                    date = dt_to_str(ts_to_dt(row["time_created"]))
            out.append({
                "session_id": r["session_id"],
                "title": title,
                "date": date,
                "source": r["source"],
                "role": r["role"],
                "snippet": r["snippet"],
                "rank": r["rank"],
            })
        if conn:
            conn.close()
        if conn2:
            conn2.close()
        print(json.dumps(out, indent=2))
        return

    for r in results:
        snippet = r["snippet"].replace("\n", " ")
        print(f"[{r['source']}] {r['session_id'][:30]}  ({r['role']})")
        print(f"  {snippet}")
        print()


def cmd_read(args):
    session_id = args.session_id

    # try opencode first
    row = None
    if OPENCODE_DB.exists():
        conn = opencode_db()
        row = conn.execute("SELECT id, title, directory FROM session WHERE id = ?", (session_id,)).fetchone()
        conn.close()

    if row:
        print(f"# {row['title']}")
        print(f"# project: {project_name_from_dir(row['directory'])}")
        print()
        messages = opencode_read_session(session_id, role_filter=args.role,
                                         include_tools=not args.no_tools)
        for m in messages:
            if m["type"] == "text":
                label = "User" if m["role"] == "user" else "Assistant"
                print(f"## {label}")
                print(m["text"])
                print()
            elif m["type"] == "tool":
                print(f"  [{m['tool']}] {m['input_summary']}")
        return

    # try OpenCode V2
    if OPENCODE2_DB.exists():
        conn = opencode2_db(OPENCODE2_DB)
        row = conn.execute(
            "SELECT id, title, directory FROM session_v2 WHERE id = ?",
            (session_id,),
        ).fetchone()
        conn.close()
        if row:
            print(f"# {row['title'] or 'OpenCode V2 session'}")
            print(f"# project: {project_name_from_dir(row['directory'])}")
            print()
            messages = opencode2_read_session(
                OPENCODE2_DB,
                session_id,
                role_filter=args.role,
                include_tools=not args.no_tools,
            )
            for message in messages:
                if message["type"] == "text":
                    label = "User" if message["role"] == "user" else "Assistant"
                    print(f"## {label}")
                    print(message["text"])
                    print()
                elif message["type"] == "tool":
                    print(f"  [{message['tool']}] {message['input_summary']}")
            return

    # try claude — session_id might be a file path or UUID
    if Path(session_id).exists():
        path = Path(session_id)
        if codex_read_metadata(path):
            messages = codex_read_session(path, role_filter=args.role, include_tools=not args.no_tools)
        else:
            messages = claude_read_session(session_id, role_filter=args.role)
        for m in messages:
            if m["type"] == "text":
                label = "User" if m["role"] == "user" else "Assistant"
                print(f"## {label}")
                print(m["text"])
                print()
            else:
                print(f"  [{m['tool']}] {m['input_summary']}")
        return

    # search claude files by session id
    if CLAUDE_DIR.exists():
        for jsonl in CLAUDE_DIR.rglob("*.jsonl"):
            if session_id in jsonl.stem:
                messages = claude_read_session(str(jsonl), role_filter=args.role)
                for m in messages:
                    label = "User" if m["role"] == "user" else "Assistant"
                    print(f"## {label}")
                    print(m["text"])
                    print()
                return

    if CODEX_DIR.exists():
        for jsonl in CODEX_DIR.rglob("*.jsonl"):
            meta = codex_read_metadata(jsonl) or {}
            codex_id = meta.get("id") or meta.get("session_id") or jsonl.stem
            if session_id in codex_id or session_id in jsonl.stem:
                messages = codex_read_session(jsonl, role_filter=args.role, include_tools=not args.no_tools)
                for m in messages:
                    if m["type"] == "text":
                        print(f"## {'User' if m['role'] == 'user' else 'Assistant'}")
                        print(m["text"])
                        print()
                    else:
                        print(f"  [{m['tool']}] {m['input_summary']}")
                return

    print(f"session not found: {session_id}", file=sys.stderr)
    sys.exit(1)


def qmd_ensure_collection():
    """Create the sessions qmd collection if it doesn't exist."""
    result = subprocess.run(["qmd", "collection", "list"], capture_output=True, text=True)
    if result.returncode != 0:
        print(f"qmd error: {result.stderr.strip()}", file=sys.stderr)
        return False
    if "sessions" not in result.stdout:
        print("creating qmd sessions collection...")
        r = subprocess.run(
            ["qmd", "collection", "add", str(VAULT_DIR), "--name", "sessions", "--mask", "**/*.md"],
            capture_output=True, text=True
        )
        if r.returncode != 0:
            print(f"qmd collection add failed: {r.stderr.strip()}", file=sys.stderr)
            return False
    return True


def qmd_index(embed: bool = True):
    """Update qmd index and optionally regenerate embeddings."""
    if not qmd_ensure_collection():
        return False

    print("updating qmd index...")
    r = subprocess.run(["qmd", "update"], capture_output=True, text=True)
    if r.returncode != 0:
        print(f"qmd update failed: {r.stderr.strip()}", file=sys.stderr)
        return False
    # print file count from output
    for line in r.stdout.strip().splitlines():
        if line.strip():
            print(f"  {line.strip()}")

    if embed:
        print("generating embeddings...")
        r = subprocess.run(["qmd", "embed"], capture_output=True, text=True)
        if r.returncode != 0:
            print(f"qmd embed failed: {r.stderr.strip()}", file=sys.stderr)
            return False
        for line in r.stdout.strip().splitlines():
            if line.strip():
                print(f"  {line.strip()}")

    return True


def cmd_index(args):
    qmd_index(embed=not args.no_embed)


def cmd_find(args):
    if not qmd_ensure_collection():
        sys.exit(1)

    # qmd query (reranked) preferred; fall back to qmd search (BM25) if it fails
    mode = "query" if not args.keyword else "search"
    try:
        result = subprocess.run(
            ["qmd", mode, args.query, "-n", str(args.limit)],
            capture_output=True, text=True, timeout=15
        )
        if result.returncode != 0:
            if mode == "query":
                # fallback to BM25
                result = subprocess.run(
                    ["qmd", "search", args.query, "-n", str(args.limit)],
                    capture_output=True, text=True, timeout=15
                )
            if result.returncode != 0:
                print(f"qmd error: {result.stderr.strip()}", file=sys.stderr)
                sys.exit(1)
        print(result.stdout, end="")
    except subprocess.TimeoutExpired:
        # query timed out (embeddings not ready?), try BM25
        if mode == "query":
            result = subprocess.run(
                ["qmd", "search", args.query, "-n", str(args.limit)],
                capture_output=True, text=True, timeout=15
            )
            if result.returncode == 0:
                print(result.stdout, end="")
            else:
                print(f"qmd error: {result.stderr.strip()}", file=sys.stderr)
                sys.exit(1)
        else:
            print("error: qmd search timed out", file=sys.stderr)
            sys.exit(1)
    except FileNotFoundError:
        print("error: qmd not found on PATH", file=sys.stderr)
        sys.exit(1)


def cmd_stats(args):
    stats: dict = {}

    # OpenCode stats
    if OPENCODE_DB.exists():
        conn = opencode_db()
        total = conn.execute("SELECT count(*) FROM session").fetchone()[0]
        top_level = conn.execute("SELECT count(*) FROM session WHERE parent_id IS NULL").fetchone()[0]
        sub = total - top_level
        msg_count = conn.execute("SELECT count(*) FROM message").fetchone()[0]
        text_parts = conn.execute(
            "SELECT count(*) FROM part WHERE json_extract(data, '$.type') = 'text'"
        ).fetchone()[0]
        conn.close()
        stats["opencode"] = {
            "sessions_total": total,
            "sessions_top_level": top_level,
            "sessions_subagent": sub,
            "messages": msg_count,
            "text_parts": text_parts,
        }
        if not args.json:
            print(f"opencode: {total} sessions ({top_level} top-level, {sub} subagent), {msg_count} messages, {text_parts} text parts")

    if OPENCODE2_DB.exists():
        opencode2 = opencode2_stats(OPENCODE2_DB)
        stats["opencode2"] = opencode2
        if not args.json:
            print(
                f"opencode2: {opencode2['sessions_total']} sessions "
                f"({opencode2['sessions_top_level']} top-level, {opencode2['sessions_subagent']} subagent), "
                f"{opencode2['messages']} messages, {opencode2['text_parts']} text parts"
            )

    # Claude stats
    if CLAUDE_DIR.exists():
        main = list(p for p in CLAUDE_DIR.rglob("*.jsonl") if "subagents" not in str(p))
        subs = list(p for p in CLAUDE_DIR.rglob("*.jsonl") if "subagents" in str(p))
        stats["claude"] = {
            "sessions": len(main),
            "sessions_subagent": len(subs),
        }
        if not args.json:
            print(f"claude: {len(main)} sessions, {len(subs)} subagent sessions")

    if CODEX_DIR.exists():
        codex_sessions = codex_list_sessions(CODEX_DIR, limit=sys.maxsize)
        codex_subs = sum(bool(session["is_subagent"]) for session in codex_sessions)
        stats["codex"] = {
            "sessions": len(codex_sessions) - codex_subs,
            "sessions_subagent": codex_subs,
        }
        if not args.json:
            print(f"codex: {len(codex_sessions) - codex_subs} sessions, {codex_subs} subagent sessions")

    # FTS stats
    if FTS_DB.exists():
        conn = sqlite3.connect(str(FTS_DB))
        count = conn.execute("SELECT count(*) FROM session_fts").fetchone()[0]
        conn.close()
        stats["fts_index"] = {"text_blocks": count}
        if not args.json:
            print(f"fts index: {count} text blocks")

    # Vault stats
    if VAULT_DIR.exists():
        oc_files = list(OPENCODE_VAULT.glob("*.md")) if OPENCODE_VAULT.exists() else []
        oc2_files = list(OPENCODE2_VAULT.glob("*.md")) if OPENCODE2_VAULT.exists() else []
        cl_files = list(CLAUDE_VAULT.glob("*.md")) if CLAUDE_VAULT.exists() else []
        cx_files = list(CODEX_VAULT.glob("*.md")) if CODEX_VAULT.exists() else []
        stats["vault"] = {
            "opencode_exported": len(oc_files),
            "opencode2_exported": len(oc2_files),
            "claude_exported": len(cl_files),
            "codex_exported": len(cx_files),
        }
        if not args.json:
            print(
                f"vault: {len(oc_files)} opencode + {len(oc2_files)} opencode2 + "
                f"{len(cl_files)} claude + {len(cx_files)} codex exported files"
            )

    if args.json:
        print(json.dumps(stats, indent=2))


# --- CLI ----------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="sessions",
        description="Search, browse, and export coding sessions from OpenCode V1/V2, Claude Code, and Codex.",
        epilog=(
            "Sources: OpenCode V1 (~/.local/share/opencode/opencode.db), "
            "OpenCode V2 (~/.local/share/opencode-v2/opencode/opencode.db), "
            "Claude Code (~/.claude/projects/)\n"
            "Codex (~/.codex/sessions/)\n"
            "Vault: ~/Vaults/Sessions/ (exported markdown with frontmatter)\n"
            "Indexes: FTS5 + qmd at ~/.local/share/sessions/\n\n"
            "Search strategy: Memory vault (curated) -> search (FTS5 keyword) -> find (semantic)"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # list
    p_list = sub.add_parser(
        "list",
        help="List sessions (newest first, queries source DBs live)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  sessions list\n"
            "  sessions list --limit 10 --source opencode\n"
            "  sessions list --json | jq '.[0]'\n"
            "  sessions list --since 2026-03-01 --project metronome"
        ),
    )
    p_list.add_argument("--source", choices=["opencode", "opencode2", "claude", "codex"], help="Filter to one source")
    p_list.add_argument("--since", help="Date filter (YYYY-MM-DD)")
    p_list.add_argument("--limit", type=int, default=20, help="Max results (default: 20)")
    p_list.add_argument("--project", help="Filter by project directory name")
    p_list.add_argument("--json", action="store_true", help="Output JSON array instead of formatted text")

    # export
    p_export = sub.add_parser(
        "export",
        help="Export sessions to vault (incremental, rebuilds FTS + qmd)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  sessions export\n"
            "  sessions export --force --no-index\n"
            "  sessions export --dry-run\n"
            "  sessions export --source opencode --since 2026-03-01"
        ),
    )
    p_export.add_argument("--source", choices=["opencode", "opencode2", "claude", "codex"], help="Export only one source")
    p_export.add_argument("--since", help="Date filter (YYYY-MM-DD)")
    p_export.add_argument("--force", action="store_true", help="Re-export all (ignore watermark)")
    p_export.add_argument("--no-index", action="store_true", help="Skip qmd re-indexing after export")
    p_export.add_argument("--dry-run", action="store_true", help="Print files that would be written without writing them")

    # search (FTS5)
    p_search = sub.add_parser(
        "search",
        help="Keyword search with FTS5 Porter stemming (requires export)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  sessions search 'useEffect'\n"
            "  sessions search 'docker build' --source opencode --role user\n"
            "  sessions search 'memory vault' --json | jq '.[].snippet'\n"
            "  sessions search 'tailwind' --context 3 --limit 5"
        ),
    )
    p_search.add_argument("query", help="Search query (FTS5 syntax supported)")
    p_search.add_argument("--source", choices=["opencode", "opencode2", "claude", "codex"], help="Filter to one source")
    p_search.add_argument("--role", choices=["user", "assistant"], help="Filter by message role")
    p_search.add_argument("--limit", type=int, default=10, help="Max results (default: 10)")
    p_search.add_argument("--context", type=int, default=0, help="Context lines around matches")
    p_search.add_argument("--json", action="store_true", help="Output JSON array instead of formatted text")

    # read
    p_read = sub.add_parser(
        "read",
        help="Read a full session transcript (queries source DBs live)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  sessions read abc123\n"
            "  sessions read abc123 --role user\n"
            "  sessions read abc123 --no-tools\n"
            "  sessions read ~/.claude/projects/-foo/session.jsonl"
        ),
    )
    p_read.add_argument("session_id", help="Session ID (OpenCode V1/V2 ID) or Claude JSONL path")
    p_read.add_argument("--role", choices=["user", "assistant"], help="Show only one role")
    p_read.add_argument("--no-tools", action="store_true", help="Hide tool call blocks")

    # find (qmd semantic)
    p_find = sub.add_parser(
        "find",
        help="Semantic search via qmd with query expansion + reranking (requires export)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  sessions find 'how to set up launchd'\n"
            "  sessions find 'python type hints' --limit 10\n"
            "  sessions find 'docker networking' --keyword"
        ),
    )
    p_find.add_argument("query", help="Natural language search query")
    p_find.add_argument("--limit", type=int, default=5, help="Max results (default: 5)")
    p_find.add_argument("--keyword", action="store_true", help="Use BM25 keyword search instead of semantic")

    # stats
    p_stats = sub.add_parser(
        "stats",
        help="Session counts, message totals, index size",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  sessions stats\n"
            "  sessions stats --json | jq '.opencode'"
        ),
    )
    p_stats.add_argument("--json", action="store_true", help="Output JSON object instead of formatted text")

    # index
    p_index = sub.add_parser("index", help="Rebuild qmd sessions collection (re-register + embed)")
    p_index.add_argument("--no-embed", action="store_true", help="Skip embedding generation")

    args = parser.parse_args()

    cmds = {
        "list": cmd_list,
        "export": cmd_export,
        "search": cmd_search,
        "read": cmd_read,
        "find": cmd_find,
        "stats": cmd_stats,
        "index": cmd_index,
    }
    cmds[args.command](args)


if __name__ == "__main__":
    main()
