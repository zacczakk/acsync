{
  "$schema": "Skill upstream registry. Consumed by scripts/sync-upstream-skills.ts",
  "skillsDir": "configs/skills",
  "summaryDir": "~/Vaults/Memory/system",
  "upstreams": {
    "anthropics": {
      "repo": "https://github.com/anthropics/skills.git",
      "basePath": "skills",
      "skills": {
        "docx": { "sync": "auto" },
        "frontend-design": { "sync": "auto" },
        "mcp-builder": { "sync": "auto" },
        "pdf": { "sync": "auto" },
        "pptx": { "sync": "auto" },
        "xlsx": { "sync": "auto" }
      }
    },
    "vercel": {
      "repo": "https://github.com/vercel-labs/agent-skills.git",
      "basePath": "skills",
      "skills": {
        "react-best-practices": { "localName": "vercel-react-best-practices", "sync": "manual", "note": "AGENTS.md moved to references/rules.md to prevent 3373-line auto-injection" },
        "web-design-guidelines": { "sync": "auto" }
      }
    },
    "kepano": {
      "repo": "https://github.com/kepano/obsidian-skills.git",
      "basePath": "skills",
      "skills": {
        "obsidian-cli": { "sync": "manual", "note": "Locally guarded: the executable launches the Electron app; never use for routine retrieval" },
        "defuddle": { "localName": "obsidian-defuddle", "sync": "auto" },
        "obsidian-markdown": { "sync": "auto" },
        "json-canvas": { "localName": "obsidian-json-canvas", "sync": "auto" },
        "obsidian-bases": { "sync": "auto" }
      }
    },
    "jakubkrehel": {
      "repo": "https://github.com/jakubkrehel/make-interfaces-feel-better.git",
      "basePath": "skills",
      "skills": {
        "make-interfaces-feel-better": { "sync": "manual" }
      }
    },
    "cursor": {
      "repo": "https://github.com/cursor/plugins.git",
      "basePath": "cursor-team-kit/skills",
      "skills": {
        "thermo-nuclear-code-quality-review": { "sync": "manual" }
      }
    },
    "obra": {
      "repo": "https://github.com/obra/superpowers.git",
      "basePath": "skills",
      "skills": {
        "brainstorming": { "sync": "auto" },
        "executing-plans": { "sync": "manual" },
        "subagent-driven-development": { "sync": "manual" },
        "using-superpowers": { "sync": "manual" },
        "verification-before-completion": { "sync": "auto" },
        "writing-plans": { "sync": "manual" }
      }
    },
    "mattpocock": {
      "repo": "https://github.com/mattpocock/skills.git",
      "basePath": "skills/engineering",
      "skills": {
        "diagnosing-bugs": { "sync": "manual" },
        "tdd": { "sync": "manual" }
      }
    }
  }
}
