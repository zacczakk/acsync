{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "~/Vaults/Memory/SOUL.md",
    "~/Vaults/Memory/IDENTITY.md",
    "~/Vaults/Memory/USER.md",
    "~/Vaults/Memory/MEMORY.md"
  ],
  "model": "tux/gpt-5.6-luna",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "cat *.env": "deny",
      "cat *.env.*": "deny",
      "cat */.env": "deny",
      "cat */.env.*": "deny",
      "cat */.env.example": "allow",
      "cat ~/.zshrc_secrets": "deny",
      "cat ~/.zsh_secrets": "deny",
      "rg * ~/.zsh_secrets": "deny",
      "rg * ~/.zshrc_secrets": "deny",
      "git push *": "ask",
      "committer *": "allow",
      "git reset --hard *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/Vaults/**": "allow",
      "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/**": "allow",
      "~/Vaults/Memory/system/grooming-reports/*": "allow",
      "~/Repos/**": "allow",
      "~/.config/opencode/*": "allow",
      "~/.config/opencode/agents/*": "allow",
      "~/.config/opencode/get-shit-done/templates/*": "allow",
      "~/.mcporter/**": "allow",
      "~/.agent-browser/**": "allow",
      "~/.agents/**": "allow",
      "~/.config/oe/**": "allow",
      "/private/tmp/**": "allow",
      "/tmp/**": "allow",
      "~/Downloads/**": "allow",
      "/var/folders/**": "allow",
      "/private/var/folders/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.zshrc_secrets": "deny",
      "~/.zsh_secrets": "deny",
      "~/.config/opencode/agents/*": "allow",
      "~/.config/opencode/commands/*": "allow",
      "~/.agents/**": "allow",
      "~/Downloads/**": "allow"
    },
    "edit": {
      "*": "allow",
      "~/.config/oe/**": "allow",
      "~/Repos/**": "deny"
    }
  },
  "agent": {
    "explore": {
      "model": "tux/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "max"
      }
    }
  },
  "plugin": [
    "context-mode",
    "./chatgpt-websearch"
  ],
  "websearch": {
    "provider": "chatgpt"
  },
  "provider": {
    "foundry": {
      "npm": "@ai-sdk/anthropic",
      "name": "Foundry",
      "options": {
        "baseURL": "{env:ANTHROPIC_BASE_URL}/v1",
        "apiKey": "{env:FOUNDRY_TOKEN}",
        "headers": {
          "Authorization": "Bearer {env:FOUNDRY_TOKEN}"
        },
        "toolStreaming": false
      },
      "models": {
        "claude-opus-5-0": {
          "name": "Claude Opus 5",
          "limit": { "output": 64000 },
          "options": { "toolStreaming": false },
          "modalities": { "input": ["image", "text"], "output": ["text"] },
          "variants": {
            "low": { "thinking": { "type": "adaptive" }, "effort": "low" },
            "medium": { "thinking": { "type": "adaptive" }, "effort": "medium" },
            "high": { "thinking": { "type": "adaptive" }, "effort": "high" }
          }
        }
      }
    },
    "tux": {
      "npm": "@ai-sdk/anthropic",
      "name": "Tux",
      "options": {
        "baseURL": "http://127.0.0.1:18080/v1",
        "apiKey": "does-not-matter",
        "toolStreaming": false
      },
      "models": {
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "cost": { "input": 5, "output": 25, "cache_read": 0.5, "cache_write": 6.25 },
          "limit": { "context": 1000000, "output": 128000 },
          "options": { "toolStreaming": false },
          "modalities": { "input": ["image", "text"], "output": ["text"] },
          "variants": {
            "low": { "thinking": { "type": "adaptive" }, "effort": "low" },
            "medium": { "thinking": { "type": "adaptive" }, "effort": "medium" },
            "high": { "thinking": { "type": "adaptive" }, "effort": "high" }
          }
        },
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7",
          "cost": { "input": 5, "output": 25, "cache_read": 0.5, "cache_write": 6.25 },
          "limit": { "context": 1000000, "output": 128000 },
          "options": { "toolStreaming": false },
          "modalities": { "input": ["image", "text"], "output": ["text"] },
          "variants": {
            "low": { "thinking": { "type": "adaptive" }, "effort": "low" },
            "medium": { "thinking": { "type": "adaptive" }, "effort": "medium" },
            "high": { "thinking": { "type": "adaptive" }, "effort": "high" }
          }
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "cost": { "input": 5, "output": 25, "cache_read": 0.5, "cache_write": 6.25 },
          "limit": { "context": 1000000, "output": 128000 },
          "options": { "toolStreaming": false },
          "modalities": { "input": ["image", "text"], "output": ["text"] },
          "variants": {
            "low": { "thinking": { "type": "adaptive" }, "effort": "low" },
            "medium": { "thinking": { "type": "adaptive" }, "effort": "medium" },
            "high": { "thinking": { "type": "adaptive" }, "effort": "high" }
          }
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "cost": { "input": 2, "output": 10, "cache_read": 0.2, "cache_write": 2.5 },
          "limit": { "context": 1000000, "output": 128000 },
          "options": { "toolStreaming": false },
          "modalities": { "input": ["image", "text"], "output": ["text"] },
          "variants": {
            "low": { "thinking": { "type": "adaptive" }, "effort": "low" },
            "medium": { "thinking": { "type": "adaptive" }, "effort": "medium" },
            "high": { "thinking": { "type": "adaptive" }, "effort": "high" }
          }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "cost": { "input": 3, "output": 15, "cache_read": 0.3, "cache_write": 3.75 },
          "limit": { "context": 200000, "output": 64000 },
          "options": { "toolStreaming": false },
          "modalities": { "input": ["image", "text"], "output": ["text"] },
          "variants": {
            "low": { "thinking": { "type": "adaptive" }, "effort": "low" },
            "medium": { "thinking": { "type": "adaptive" }, "effort": "medium" },
            "high": { "thinking": { "type": "adaptive" }, "effort": "high" }
          }
        },
        "claude-haiku-4-5-20251001": {
