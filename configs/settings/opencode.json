        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "cost": { "input": 2, "output": 12, "cache_read": 0.2, "cache_write": 2.5 },
          "provider": { "npm": "@ai-sdk/openai" },
          "limit": { "context": 1050000, "output": 128000 },
          "reasoning": true,
          "options": { "reasoningSummary": "auto" },
          "modalities": { "input": ["image", "text"], "output": ["text"] },
          "variants": {
