// OpenCode MCP config
{
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "palantir-mcp": {
      "type": "local",
      "command": [
        "tux",
        "palantir-mcp",
        "start"
      ],
      "enabled": true,
      "timeout": 20000
    },
    "tavily": {
      "type": "local",
      "command": [
        "tavily-mcp"
      ],
      "environment": {
        "TAVILY_API_KEY": "{env:TAVILY_API_KEY}",
        "UPTIMIZE_ENV": "dev"
      },
      "enabled": false
    },
    "peekaboo": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@steipete/peekaboo@latest",
        "mcp"
      ],
      "enabled": false,
      "timeout": 30000
    },
    "context-mode": {
      "type": "local",
      "command": [
        "context-mode"
      ],
      "environment": {
        "CONTEXT_MODE_IDLE_TIMEOUT_MS": "900000"
      },
      "enabled": true
    },
    "chrome-devtools-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--no-usage-statistics"
      ],
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true,
      "oauth": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": false
    }
  }
}
